generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../../aitk_db.db"
}

model Settings {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Queue {
  id         Int     @id @default(autoincrement())
  gpu_ids    String  @unique
  is_running Boolean @default(false)

  @@index([gpu_ids])
}

model Job {
  id              String          @id @default(uuid())
  name            String          @unique
  gpu_ids         String
  job_config      String // JSON string
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  status          String          @default("stopped")
  stop            Boolean         @default(false)
  return_to_queue Boolean         @default(false) // same as stop, but will be set to 'queued' when stopped
  step            Int             @default(0)
  info            String          @default("")
  speed_string    String          @default("")
  queue_position  Int             @default(0)
  runtimeParams   RuntimeParams?

  @@index([status])
  @@index([gpu_ids])
}

model RuntimeParams {
  jobId                    String   @id
  job                      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  runtime_lr               Float?
  runtime_min_lr           Float?
  runtime_gaussian_mean    Float?
  runtime_gaussian_std     Float?
  runtime_gaussian_mean_2  Float?
  runtime_gaussian_std_2   Float?
  runtime_weight_decay     Float?
  runtime_weight_decay_increment Float?
  runtime_weight_decay_mode String?
  runtime_beta1            Float?
  runtime_beta2            Float?
  runtime_content_or_style String?
  runtime_timestep_type    String?
  runtime_timestep_weighting String?
  runtime_network_weights  String?
  runtime_fixed_cycle_timesteps String?
  runtime_fixed_cycle_seed Int?
  runtime_fixed_cycle_weight_peak_timesteps String?
  runtime_fixed_cycle_weight_sigma Float?
  runtime_turbo_prior_steps Int?
  runtime_turbo_t_jitter Float?
  runtime_turbo_teacher_weight Boolean?
  runtime_batch_size       Int?
  runtime_gradient_accumulation Int?
  runtime_save_every       Int?
  runtime_sample_every     Int?
  runtime_prompts          String?
  runtime_warmup_steps     Int?
  runtime_warmup_boost     Float?
  runtime_scale_lr_by_index Boolean?
  runtime_scale_lr_factor  Float?
  runtime_min_snr_gamma    Float?
  runtime_debug            Boolean?
  updated_at               DateTime @updatedAt
}
